# Local PostgreSQL in Docker (docker-compose.yml).
# Copy this file to .env and choose your own password. Never commit .env.
POSTGRES_DB=libraryhive
POSTGRES_USER=libraryhive
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_PORT=5432

# The backend reads its own backend/.env (created in task T01), for example:
# DATABASE_URL=postgres://libraryhive:<your password>@127.0.0.1:5432/libraryhive
