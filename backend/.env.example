# Copy to backend/.env for local development. Never commit backend/.env.
# Full variable list: BACKEND_ARCHITECTURE.md section 13.

# --- Core ---------------------------------------------------------------
# local | test | production (manage.py picks local by default, test for `manage.py test`)
DJANGO_SETTINGS_MODULE=config.settings.local
ENVIRONMENT=local
SECRET_KEY=generate-a-long-random-value-for-local-use
# Separate key for signing JWTs (SECURITY.md 4.1)
JWT_SIGNING_KEY=generate-another-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=dev
LOG_LEVEL=INFO

# --- Database (PostgreSQL in Docker, see ../docker-compose.yml) ----------
DATABASE_URL=postgres://libraryhive:<your password from ../.env>@127.0.0.1:5432/libraryhive

# --- Frontend / CORS -----------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Media storage: local (filesystem) or s3 (S3-compatible) -------------
STORAGE_BACKEND=local
# Only when STORAGE_BACKEND=s3. Names and placeholders only: put the real values in the host's
# secret settings (Render), never in this file or in git. Example below is for Supabase Storage.
# AWS_STORAGE_BUCKET_NAME=libraryhive-public        # PUBLIC bucket: library photos only
# AWS_PRIVATE_BUCKET_NAME=libraryhive-private       # PRIVATE bucket: UPI QR codes and payment screenshots
# AWS_S3_ENDPOINT_URL=<exact endpoint from Supabase: Storage > S3 Configuration, https://...>
# AWS_S3_REGION_NAME=ap-south-1                      # required with a custom endpoint (signing region)
# AWS_S3_ADDRESSING_STYLE=path                       # default: path
# AWS_S3_SIGNATURE_VERSION=s3v4                      # default: s3v4
# AWS_ACCESS_KEY_ID=<S3 access key id from Supabase>
# AWS_SECRET_ACCESS_KEY=<S3 secret access key from Supabase>
# Full public URL prefix of the PUBLIC bucket INCLUDING the bucket path (the object key is appended to it).
# Supabase: https://<project-ref>.supabase.co/storage/v1/object/public/libraryhive-public
# MEDIA_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/libraryhive-public

# --- Email (console backend locally) -------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LibraryHive <no-reply@localhost>
# Email notifications. Production defaults to false and refuses true with the console/locmem/dummy/file backends,
# because those would mark emails as sent without delivering them. Set true only with a real EMAIL_BACKEND.
EMAIL_NOTIFICATIONS_ENABLED=true

# --- Payments (Razorpay) ---------------------------------------------------------
# Test-mode keys for development; live keys only in production. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Online payments still pending after this many minutes are checked against the gateway.
PAYMENT_RECONCILE_AFTER_MINUTES=30

# --- Admin -----------------------------------------------------------------
ADMIN_URL=admin/

# Scheduled jobs: on the free-tier deployment GitHub Actions runs them (BACKEND_ARCHITECTURE.md 11.4); run them from
# ONE scheduler only. Locally: `python manage.py run_scheduled_jobs --dry-run`. The HTTP fallback (POST /api/v1/internal/jobs/run/)
# is disabled unless this token is set; send it in the X-Job-Token header. Leave empty to keep it off.
JOB_TRIGGER_TOKEN=
