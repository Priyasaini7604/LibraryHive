# Copy to backend/.env for local development. Never commit backend/.env.
# Full variable list: BACKEND_ARCHITECTURE.md section 13.

# --- Core ---------------------------------------------------------------
# local | test | production (manage.py picks local by default, test for `manage.py test`)
DJANGO_SETTINGS_MODULE=config.settings.local
ENVIRONMENT=local
SECRET_KEY=generate-a-long-random-value-for-local-use
# Separate key for signing JWTs (SECURITY.md 4.1)
JWT_SIGNING_KEY=generate-another-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=dev
LOG_LEVEL=INFO

# --- Database (PostgreSQL in Docker, see ../docker-compose.yml) ----------
DATABASE_URL=postgres://libraryhive:<your password from ../.env>@127.0.0.1:5432/libraryhive

# --- Frontend / CORS -----------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Media storage: local (filesystem) or s3 (S3-compatible) -------------
STORAGE_BACKEND=local
# Only when STORAGE_BACKEND=s3:
# AWS_STORAGE_BUCKET_NAME=
# AWS_PRIVATE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=

# --- Email (console backend locally) -------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LibraryHive <no-reply@localhost>

# --- Admin -----------------------------------------------------------------
ADMIN_URL=admin/
