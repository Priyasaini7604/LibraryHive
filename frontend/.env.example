# Copy to frontend/.env.local. Never commit .env.local.

# Public: the backend API the browser calls directly (all endpoints except /auth).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Server-only: where the Next.js server proxies /api/v1/auth/* (SEC-1: the refresh
# cookie must be first-party to the frontend). Same backend, origin only.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Server-only, optional: origin serving uploaded library photos (S3 bucket / CDN),
# added to the Content-Security-Policy img-src. Locally photos come from the backend.
MEDIA_ORIGIN=http://127.0.0.1:8000

# Public, optional: map tiles. Defaults to OpenStreetMap's own servers (pilot only: light use, no SLA).
# A custom template must be https and contain {z}, {x} and {y}; its origin is added to the CSP img-src.
# Attribution is required by every provider and defaults to the OpenStreetMap credit line.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
